# Copia este archivo como .env.local y completa los valores.

# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Correo donde recibes los mensajes del formulario
CONTACT_TO_EMAIL=

# Remitente. Sin dominio verificado en Resend, deja onboarding@resend.dev:
# en ese modo Resend solo entrega al correo de tu propia cuenta.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Solo desarrollo: 1 simula el envío e imprime el correo en la terminal.
# CONTACT_DRY_RUN=1
